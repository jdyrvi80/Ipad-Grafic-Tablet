<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>it</string>
	<key>CFBundleDisplayName</key>
	<string>iPad Graphic Tablet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Jody Riva</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>iPad Graphic Tablet usa la rete locale per ricevere la Apple Pencil dal tuo iPad via Wi-Fi. Nessun dato lascia la rete.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Nella modalità Display l'app mostra sull'iPad il monitor (o l'area che scegli) per disegnarci sopra con la Apple Pencil. Le immagini restano sulla rete locale.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ipadtablet._tcp</string>
		<string>_ipadtablet-pair._tcp</string>
	</array>
</dict>
</plist>
